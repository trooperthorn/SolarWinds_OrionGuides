              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
HOST_UUID=$(xe host-list --minimal | cut -d',' -f1)
ENABLED=$(xe host-param-get uuid=$HOST_UUID param-name=enabled)
LIVE=$(xe host-param-get uuid=$HOST_UUID param-name=live)
if [ "$ENABLED" = "true" ] &amp;&amp; [ "$LIVE" = "true" ]; then
  STATE=1
else
  STATE=0
fi
echo "Host_Available : $STATE"</Value>
