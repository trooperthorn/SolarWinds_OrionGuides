          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ExecutionMode</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>SSH</Value>
              <ValueType>Option</ValueType>
              <Key i:nil="true"/>
            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptArguments</s:Key>
            <s:Value>
              <Required>false</Required>
              <SettingLevel>Template</SettingLevel>
              <Value/>
              <ValueType>String</ValueType>
              <Key i:nil="true"/>
            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptBody</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
TMP=$(mktemp)
for uuid in $(xe vm-list power-state=running is-control-domain=false params=uuid --minimal | tr ',' '\n'); do
  [ -z "$uuid" ] &amp;&amp; continue
  NAME=$(xe vm-param-get uuid=$uuid param-name=name-label)
  TOTAL=0
  for ds in $(xe vm-data-source-list uuid=$uuid params=name-label --minimal 2&gt;/dev/null | tr ',' '\n' | grep -E '^cpu[0-9]+$'); do
    VAL=$(xe vm-data-source-query uuid=$uuid data-source=$ds 2&gt;/dev/null || echo 0)
    TOTAL=$(awk -v t="$TOTAL" -v v="$VAL" 'BEGIN { printf "%.4f", t + v }')
  done
  PCT=$(awk -v t="$TOTAL" 'BEGIN { printf "%.2f", t * 100 }')
  SAFE_NAME=$(echo "$NAME" | tr -c 'A-Za-z0-9_' '_')
  echo "$PCT $SAFE_NAME" &gt;&gt; "$TMP"
done
sort -rn "$TMP" | head -5 | while read -r pct name; do
  echo "VM_${name}_CPU_Percent : $pct"
done
rm -f "$TMP"</Value>
