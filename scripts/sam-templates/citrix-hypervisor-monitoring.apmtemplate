<?xml version="1.0" encoding="utf-8"?>
<ArrayOfApplicationTemplate
    xmlns:i="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schemas.solarwinds.com/2007/08/APM">
  <ApplicationTemplate>
    <Id>0</Id>
    <UniqueId>2d7aaafd-7311-4bdc-ba12-004c6d503938</UniqueId>
    <Name>Citrix Hypervisor (XenServer) Host Monitoring</Name>
    <Description>Polls a Citrix Hypervisor (XenServer / XCP-ng) host over SSH using the local xe CLI for host CPU, memory, VM power-state counts and default storage repository utilization, plus a TCP check of the XenAPI management port. Assign to the pool master or an individual host node. See docs/modules/sam-citrix-hypervisor-template.md for setup, required rights and known limitations.</Description>
    <IsMockTemplate>false</IsMockTemplate>
    <Created>2026-09-16T00:00:00.0000000Z</Created>
