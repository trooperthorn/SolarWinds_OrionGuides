							<Value>#!/bin/sh
set -e

Hostname=$1

memory_total_kib=`xe host-data-source-query hostname=$Hostname data-source=memory_total_kib`

if [ -z $memory_total_kib ]
then
memory_total_kib=0
fi

memory_total_mb=$(echo $memory_total_kib*0.001024 | bc)
memory_total_mb=`printf "%0.3f\n" $memory_total_mb`

echo "Statistic.Host_TotalMemoryMB : $memory_total_mb";
exit 0</Value>
