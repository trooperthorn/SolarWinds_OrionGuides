            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptArguments</s:Key>
            <s:Value>
              <Required>false</Required>
              <SettingLevel>Template</SettingLevel>
              <Value/>
              <ValueType>String</ValueType>
              <Key i:nil="true"/>
            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptBody</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
SR_UUID=$(xe pool-list params=default-SR --minimal)
SIZE=$(xe sr-param-get uuid=$SR_UUID param-name=physical-size)
UTIL=$(xe sr-param-get uuid=$SR_UUID param-name=physical-utilisation)
FREE=$((SIZE - UTIL))
PCT=$(awk -v s="$SIZE" -v u="$UTIL" 'BEGIN { if (s &gt; 0) printf "%.2f", u / s * 100; else print "0" }')
echo "SR_Used_Percent : $PCT"
echo "SR_Free_Bytes : $FREE"
echo "SR_Size_Bytes : $SIZE"</Value>
              <ValueType>External</ValueType>
              <Key i:nil="true"/>
            </s:Value>
