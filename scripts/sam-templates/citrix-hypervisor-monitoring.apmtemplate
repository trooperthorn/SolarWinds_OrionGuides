            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptBody</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
HOST_UUID=$(xe host-list --minimal | cut -d',' -f1)
MGMT_DEVICE=$(xe pif-list host-uuid=$HOST_UUID management=true params=device --minimal | cut -d',' -f1)
if [ -z "$MGMT_DEVICE" ]; then
  echo "Management_NIC_RX_Bytes_Per_Sec : 0"
  echo "Management_NIC_TX_Bytes_Per_Sec : 0"
  exit 0
fi
RX=$(xe host-data-source-query data-source=pif_${MGMT_DEVICE}_rx host-uuid=$HOST_UUID 2&gt;/dev/null || echo 0)
TX=$(xe host-data-source-query data-source=pif_${MGMT_DEVICE}_tx host-uuid=$HOST_UUID 2&gt;/dev/null || echo 0)
echo "Management_NIC_RX_Bytes_Per_Sec : $RX"
echo "Management_NIC_TX_Bytes_Per_Sec : $TX"</Value>
