					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>__UserDescription</s:Key>
						<s:Value>
							<Required>false</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>CPU utilization, free and installed memory, enabled/live state and dom0 uptime for the named Citrix Hypervisor host, in one SSH session.
Units: Percent, MB, MB, 1/0, Seconds
Inputs:
a.	Xen Server Hostname
Condition: the SSH target must be a member of the same pool.</Value>
							<ValueType>String</ValueType>
							<Key>__UserDescription</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>__UserNotes</s:Key>
						<s:Value>
							<Required>false</Required>
							<SettingLevel>Template</SettingLevel>
							<Value></Value>
							<ValueType>String</ValueType>
							<Key>__UserNotes</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>AuthenticationType</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>UsernamePassword</Value>
							<ValueType>Option</ValueType>
							<Key>AuthenticationType</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>CommandLineToPass</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>/bin/sh ${SCRIPT} &lt;XenServerHostname&gt;</Value>
							<ValueType>String</ValueType>
							<Key>CommandLineToPass</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>CountAsDifference</s:Key>
						<s:Value>
							<Required>false</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>false</Value>
							<ValueType>Boolean</ValueType>
							<Key>CountAsDifference</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>Port</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>22</Value>
							<ValueType>Integer</ValueType>
							<Key>Port</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>ScriptBody</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>#!/bin/sh
# Emits Message.&lt;Name&gt; / Statistic.&lt;Name&gt; pairs; on any failure prints one
# "Message:" line explaining why and exits 1 so SAM marks the component Down.
fail() { echo "Message: $1"; exit 1; }
need_xe() { command -v xe &gt;/dev/null 2&gt;&amp;1 || fail "xe not found on the SSH target; run this against a pool member (dom0)"; }
# ds &lt;hostname&gt; &lt;data-source&gt;  -&gt; prints the value or fails
ds() {
  v=`xe host-data-source-query hostname="$1" data-source="$2" 2&gt;&amp;1` || fail "xe host-data-source-query $2 failed for host $1: $v"
  [ -z "$v" ] &amp;&amp; v=0
  echo "$v"
}

Hostname=$1
[ -z "$Hostname" ] &amp;&amp; fail "missing argument XenServerHostname; set it on the component"
need_xe
xe host-list hostname="$Hostname" params=uuid --minimal 2&gt;/dev/null | grep -q . || fail "no host named $Hostname in this pool"

cpu_avg=`ds "$Hostname" cpu_avg`
cpu_avg=`echo "$cpu_avg*100" | bc`
cpu_avg=`printf "%0.2f" $cpu_avg`
memory_free_mb=`printf "%0.3f" $(echo "$(ds "$Hostname" memory_free_kib)*0.001024" | bc)`
memory_total_mb=`printf "%0.3f" $(echo "$(ds "$Hostname" memory_total_kib)*0.001024" | bc)`
enabled=`xe host-list hostname="$Hostname" params=enabled --minimal`
live=`xe host-list hostname="$Hostname" params=live --minimal`
if [ "$enabled" = "true" ] &amp;&amp; [ "$live" = "true" ]; then state=1; else state=0; fi
uptime_seconds=`awk '{print int($1)}' /proc/uptime`

echo "Message.Host_CPU_Utilization: $Hostname mean physical CPU utilization: $cpu_avg %"
echo "Statistic.Host_CPU_Utilization: $cpu_avg"
echo "Message.Host_FreeMemoryMB: $Hostname free memory: $memory_free_mb MB"
echo "Statistic.Host_FreeMemoryMB: $memory_free_mb"
echo "Message.Host_TotalMemoryMB: $Hostname installed memory: $memory_total_mb MB"
echo "Statistic.Host_TotalMemoryMB: $memory_total_mb"
echo "Message.Host_EnabledAndLive: $Hostname enabled=$enabled live=$live"
echo "Statistic.Host_EnabledAndLive: $state"
echo "Message.Host_UptimeSeconds: dom0 on the SSH target up $uptime_seconds s"
echo "Statistic.Host_UptimeSeconds: $uptime_seconds"
exit 0
</Value>
							<ValueType>External</ValueType>
							<Key>ScriptBody</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
