						<s:Key>ScriptBody</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>#!/bin/sh
# Emits Message.&lt;Name&gt; / Statistic.&lt;Name&gt; pairs; on any failure prints one
# "Message:" line explaining why and exits 1 so SAM marks the component Down.
fail() { echo "Message: $1"; exit 1; }
need_xe() { command -v xe &gt;/dev/null 2&gt;&amp;1 || fail "xe not found on the SSH target; run this against a pool member (dom0)"; }
# ds &lt;hostname&gt; &lt;data-source&gt;  -&gt; prints the value or fails
ds() {
  v=`xe host-data-source-query hostname="$1" data-source="$2" 2&gt;&amp;1` || fail "xe host-data-source-query $2 failed for host $1: $v"
  [ -z "$v" ] &amp;&amp; v=0
  echo "$v"
}

need_xe
count_state() {
  out=`xe vm-list power-state="$1" is-control-domain=false params=uuid --minimal 2&gt;&amp;1` || fail "xe vm-list power-state=$1 failed: $out"
  echo "$out" | tr ',' '\n' | grep -c .
}
running=`count_state running`
halted=`count_state halted`
suspended=`count_state suspended`

echo "Message.Pool_VMsRunning: $running VMs running (control domains excluded)"
echo "Statistic.Pool_VMsRunning: $running"
echo "Message.Pool_VMsHalted: $halted VMs halted"
echo "Statistic.Pool_VMsHalted: $halted"
echo "Message.Pool_VMsSuspended: $suspended VMs suspended"
echo "Statistic.Pool_VMsSuspended: $suspended"
exit 0
</Value>
