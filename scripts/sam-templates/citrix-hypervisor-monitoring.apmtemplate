            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
ATTACHED_VDIS=$(xe vbd-list params=vdi-uuid --minimal | tr ',' '\n')
COUNT=0
TOTAL_BYTES=0
for vdi in $(xe vdi-list params=uuid --minimal | tr ',' '\n'); do
  [ -z "$vdi" ] &amp;&amp; continue
  if ! echo "$ATTACHED_VDIS" | grep -q "^$vdi$"; then
    COUNT=$((COUNT + 1))
    SIZE=$(xe vdi-param-get uuid=$vdi param-name=virtual-size 2&gt;/dev/null || echo 0)
    TOTAL_BYTES=$((TOTAL_BYTES + SIZE))
  fi
done
TOTAL_GIB=$(awk -v b="$TOTAL_BYTES" 'BEGIN { printf "%.2f", b / 1073741824 }')
echo "Orphaned_VDI_Count : $COUNT"
echo "Orphaned_VDI_Total_GiB : $TOTAL_GIB"</Value>
              <ValueType>External</ValueType>
