          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptArguments</s:Key>
            <s:Value>
              <Required>false</Required>
              <SettingLevel>Template</SettingLevel>
              <Value/>
              <ValueType>String</ValueType>
              <Key i:nil="true"/>
            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptBody</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
count_vms() {
  local list
  list=$(xe vm-list power-state=$1 is-control-domain=false params=uuid --minimal)
  if [ -z "$list" ]; then
    echo 0
  else
    echo "$list" | tr ',' '\n' | grep -c .
  fi
}
echo "VMs_Running : $(count_vms running)"
echo "VMs_Halted : $(count_vms halted)"
echo "VMs_Suspended : $(count_vms suspended)"</Value>
              <ValueType>External</ValueType>
