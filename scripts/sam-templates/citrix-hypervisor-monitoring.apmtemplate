							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>#!/bin/sh
set -e

Hostname=$1
IfName=$2

pif_rx=`xe host-data-source-query hostname=$Hostname data-source=pif_"$IfName"_rx`

if [ -z $pif_rx ]
then
pif_rx=0
fi

pif_rx=`printf "%0.3f\n" $pif_rx`

echo "Statistic.Host_InterfaceReceiveBytesPerSec : $pif_rx";
exit 0</Value>
