							<Value>false</Value>
							<ValueType>Boolean</ValueType>
							<Key>CountAsDifference</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>Port</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>22</Value>
							<ValueType>Integer</ValueType>
							<Key>Port</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>ScriptBody</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>#!/bin/sh
set -e

now=`date -u +%s`
max_age=0
for uuid in `xe snapshot-list is-a-snapshot=true params=uuid --minimal | tr ',' '\n'`; do
[ -z "$uuid" ] &amp;&amp; continue
created=`xe snapshot-param-get uuid=$uuid param-name=snapshot-time`
created_epoch=`date -u -d "$(echo $created | sed 's/T/ /')" +%s 2&gt;/dev/null || echo $now`
age_days=$(( (now - created_epoch) / 86400 ))
if [ $age_days -gt $max_age ]; then
max_age=$age_days
fi
done

echo "Statistic.Pool_OldestSnapshotAgeDays : $max_age";
exit 0</Value>
