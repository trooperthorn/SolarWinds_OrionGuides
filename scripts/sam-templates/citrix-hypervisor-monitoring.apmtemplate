            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>False</Value>
              <ValueType>Boolean</ValueType>
              <Key i:nil="true"/>
            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ExecutionMode</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>SSH</Value>
              <ValueType>Option</ValueType>
              <Key i:nil="true"/>
            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptArguments</s:Key>
            <s:Value>
              <Required>false</Required>
              <SettingLevel>Template</SettingLevel>
              <Value/>
              <ValueType>String</ValueType>
              <Key i:nil="true"/>
            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptBody</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
NOW=$(date -u +%s)
COUNT=0
MAX_AGE_DAYS=0
for uuid in $(xe snapshot-list is-a-snapshot=true params=uuid --minimal | tr ',' '\n'); do
  [ -z "$uuid" ] &amp;&amp; continue
  COUNT=$((COUNT + 1))
  CREATED=$(xe snapshot-param-get uuid=$uuid param-name=snapshot-time 2&gt;/dev/null)
  CREATED_EPOCH=$(date -u -d "$(echo $CREATED | sed 's/T/ /')" +%s 2&gt;/dev/null || echo $NOW)
  AGE_DAYS=$(( (NOW - CREATED_EPOCH) / 86400 ))
  if [ $AGE_DAYS -gt $MAX_AGE_DAYS ]; then
    MAX_AGE_DAYS=$AGE_DAYS
  fi
done
echo "Snapshot_Count : $COUNT"
echo "Oldest_Snapshot_Age_Days : $MAX_AGE_DAYS"</Value>
