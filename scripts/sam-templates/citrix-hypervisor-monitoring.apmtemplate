					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>CommandLineToPass</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>/bin/sh ${SCRIPT}</Value>
							<ValueType>String</ValueType>
							<Key>CommandLineToPass</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>CountAsDifference</s:Key>
						<s:Value>
							<Required>false</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>false</Value>
							<ValueType>Boolean</ValueType>
							<Key>CountAsDifference</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>Port</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>22</Value>
							<ValueType>Integer</ValueType>
							<Key>Port</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>ScriptBody</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>#!/bin/sh
# Emits Message.&lt;Name&gt; / Statistic.&lt;Name&gt; pairs; on any failure prints one
# "Message:" line explaining why and exits 1 so SAM marks the component Down.
fail() { echo "Message: $1"; exit 1; }
need_xe() { command -v xe &gt;/dev/null 2&gt;&amp;1 || fail "xe not found on the SSH target; run this against a pool member (dom0)"; }
# ds &lt;hostname&gt; &lt;data-source&gt;  -&gt; prints the value or fails
ds() {
  v=`xe host-data-source-query hostname="$1" data-source="$2" 2&gt;&amp;1` || fail "xe host-data-source-query $2 failed for host $1: $v"
  [ -z "$v" ] &amp;&amp; v=0
  echo "$v"
}

need_xe
snaps=`xe snapshot-list is-a-snapshot=true params=uuid --minimal 2&gt;&amp;1` || fail "xe snapshot-list failed: $snaps"
snap_count=`echo "$snaps" | tr ',' '\n' | grep -c .`

now=`date -u +%s`
max_age=0
for uuid in `echo "$snaps" | tr ',' '\n'`; do
  [ -z "$uuid" ] &amp;&amp; continue
  created=`xe snapshot-param-get uuid="$uuid" param-name=snapshot-time 2&gt;/dev/null`
  created_epoch=`date -u -d "$(echo $created | sed 's/T/ /')" +%s 2&gt;/dev/null || echo $now`
  age_days=$(( (now - created_epoch) / 86400 ))
  [ $age_days -gt $max_age ] &amp;&amp; max_age=$age_days
done

attached=`xe vbd-list params=vdi-uuid --minimal 2&gt;&amp;1` || fail "xe vbd-list failed: $attached"
attached=`echo "$attached" | tr ',' '\n'`
vdis=`xe vdi-list params=uuid --minimal 2&gt;&amp;1` || fail "xe vdi-list failed: $vdis"
orphaned=0
for vdi in `echo "$vdis" | tr ',' '\n'`; do
  [ -z "$vdi" ] &amp;&amp; continue
  echo "$attached" | grep -q "^$vdi\$" || orphaned=$((orphaned + 1))
done

echo "Message.Pool_SnapshotCount: $snap_count VM snapshots in the pool"
echo "Statistic.Pool_SnapshotCount: $snap_count"
echo "Message.Pool_OldestSnapshotAgeDays: oldest snapshot is $max_age days old"
echo "Statistic.Pool_OldestSnapshotAgeDays: $max_age"
echo "Message.Pool_OrphanedVDICount: $orphaned virtual disks attached to no VBD"
echo "Statistic.Pool_OrphanedVDICount: $orphaned"
exit 0
</Value>
							<ValueType>External</ValueType>
							<Key>ScriptBody</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
