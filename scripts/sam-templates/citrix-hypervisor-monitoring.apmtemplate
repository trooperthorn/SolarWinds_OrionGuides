            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptBody</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
HOST_UUID=$(xe host-list --minimal | cut -d',' -f1)
HOST_CORES=$(xe host-param-get uuid=$HOST_UUID param-name=cpu_info param-key=cpu_count 2&gt;/dev/null || echo 0)
HOST_MEM_BYTES=$(xe host-param-get uuid=$HOST_UUID param-name=memory-total)
TOTAL_VCPUS=0
TOTAL_MEM_BYTES=0
for uuid in $(xe vm-list power-state=running is-control-domain=false params=uuid --minimal | tr ',' '\n'); do
  [ -z "$uuid" ] &amp;&amp; continue
  VCPUS=$(xe vm-param-get uuid=$uuid param-name=VCPUs-max)
  MEM=$(xe vm-param-get uuid=$uuid param-name=memory-actual)
  TOTAL_VCPUS=$((TOTAL_VCPUS + VCPUS))
  TOTAL_MEM_BYTES=$((TOTAL_MEM_BYTES + MEM))
done
VCPU_RATIO=$(awk -v v="$TOTAL_VCPUS" -v c="$HOST_CORES" 'BEGIN { if (c &gt; 0) printf "%.2f", v / c; else print "0" }')
TOTAL_MEM_MIB=$((TOTAL_MEM_BYTES / 1048576))
HOST_MEM_MIB=$((HOST_MEM_BYTES / 1048576))
echo "Allocated_vCPUs : $TOTAL_VCPUS"
echo "Physical_CPU_Cores : $HOST_CORES"
echo "vCPU_to_Core_Ratio : $VCPU_RATIO"
echo "Allocated_Memory_MiB : $TOTAL_MEM_MIB"
echo "Physical_Memory_MiB : $HOST_MEM_MIB"</Value>
