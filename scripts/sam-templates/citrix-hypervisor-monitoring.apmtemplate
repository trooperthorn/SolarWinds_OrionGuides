					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>Port</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>22</Value>
							<ValueType>Integer</ValueType>
							<Key>Port</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>ScriptBody</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>#!/bin/sh
# Emits Message.&lt;Name&gt; / Statistic.&lt;Name&gt; pairs; on any failure prints one
# "Message:" line explaining why and exits 1 so SAM marks the component Down.
fail() { echo "Message: $1"; exit 1; }
need_xe() { command -v xe &gt;/dev/null 2&gt;&amp;1 || fail "xe not found on the SSH target; run this against a pool member (dom0)"; }
# ds &lt;hostname&gt; &lt;data-source&gt;  -&gt; prints the value or fails
ds() {
  v=`xe host-data-source-query hostname="$1" data-source="$2" 2&gt;&amp;1` || fail "xe host-data-source-query $2 failed for host $1: $v"
  [ -z "$v" ] &amp;&amp; v=0
  echo "$v"
}

need_xe
sr_uuid=`xe pool-list params=default-SR --minimal 2&gt;&amp;1` || fail "xe pool-list failed: $sr_uuid"
[ -z "$sr_uuid" ] || [ "$sr_uuid" = "&lt;not in database&gt;" ] &amp;&amp; fail "the pool has no default storage repository configured"
size=`xe sr-param-get uuid="$sr_uuid" param-name=physical-size 2&gt;&amp;1` || fail "xe sr-param-get physical-size failed: $size"
util=`xe sr-param-get uuid="$sr_uuid" param-name=physical-utilisation 2&gt;&amp;1` || fail "xe sr-param-get physical-utilisation failed: $util"
sr_name=`xe sr-param-get uuid="$sr_uuid" param-name=name-label 2&gt;/dev/null`

pct=`awk -v s="$size" -v u="$util" 'BEGIN { if (s &gt; 0) printf "%.2f", u * 100 / s; else print "0" }'`
free_gb=`awk -v s="$size" -v u="$util" 'BEGIN { printf "%.3f", (s - u) / 1073741824 }'`

echo "Message.Pool_DefaultSRUsedPercent: default SR '$sr_name' is $pct % used"
echo "Statistic.Pool_DefaultSRUsedPercent: $pct"
echo "Message.Pool_DefaultSRFreeGB: default SR '$sr_name' has $free_gb GB free"
echo "Statistic.Pool_DefaultSRFreeGB: $free_gb"
exit 0
</Value>
							<ValueType>External</ValueType>
							<Key>ScriptBody</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
