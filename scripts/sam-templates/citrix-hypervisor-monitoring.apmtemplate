					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>Port</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>22</Value>
							<ValueType>Integer</ValueType>
							<Key>Port</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>ScriptBody</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>#!/bin/sh
set -e

Hostname=$1

cpu_avg=`xe host-data-source-query hostname=$Hostname data-source=cpu_avg`

if [ -z $cpu_avg ]
then
cpu_avg=0
fi

cpu_avg=$(echo $cpu_avg*100 | bc)
cpu_avg=`printf "%0.2f\n" $cpu_avg`

echo "Statistic.Host_CPU_Utilization : $cpu_avg";
exit 0</Value>
							<ValueType>External</ValueType>
							<Key>ScriptBody</Key>
						</s:Value>
