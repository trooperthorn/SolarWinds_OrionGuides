            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptArguments</s:Key>
            <s:Value>
              <Required>false</Required>
              <SettingLevel>Template</SettingLevel>
              <Value/>
              <ValueType>String</ValueType>
              <Key i:nil="true"/>
            </s:Value>
          </s:KeyValueOfstringSettingValueyR_SGpLPx>
          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptBody</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
HOST_UUID=$(xe host-list --minimal | cut -d',' -f1)
TOTAL_KIB=$(xe host-data-source-query data-source=memory_total_kib host-uuid=$HOST_UUID 2&gt;/dev/null)
FREE_KIB=$(xe host-data-source-query data-source=memory_free_kib host-uuid=$HOST_UUID 2&gt;/dev/null)
USED_PCT=$(awk -v t="$TOTAL_KIB" -v f="$FREE_KIB" 'BEGIN { if (t &gt; 0) printf "%.2f", (t - f) / t * 100; else print "0" }')
echo "Memory_Used_Percent : $USED_PCT"
echo "Memory_Free_KiB : $FREE_KIB"
echo "Memory_Total_KiB : $TOTAL_KIB"</Value>
