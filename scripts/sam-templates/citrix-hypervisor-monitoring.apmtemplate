          <s:KeyValueOfstringSettingValueyR_SGpLPx xmlns:s="http://schemas.datacontract.org/2004/07/System.Collections.Generic">
            <s:Key>ScriptBody</s:Key>
            <s:Value>
              <Required>true</Required>
              <SettingLevel>Template</SettingLevel>
              <Value>#!/bin/bash
set -e
for uuid in $(xe sr-list content-type=user params=uuid --minimal | tr ',' '\n'); do
  [ -z "$uuid" ] &amp;&amp; continue
  NAME=$(xe sr-param-get uuid=$uuid param-name=name-label)
  SIZE=$(xe sr-param-get uuid=$uuid param-name=physical-size)
  UTIL=$(xe sr-param-get uuid=$uuid param-name=physical-utilisation)
  SAFE_NAME=$(echo "$NAME" | tr -c 'A-Za-z0-9_' '_')
  PCT=$(awk -v s="$SIZE" -v u="$UTIL" 'BEGIN { if (s &gt; 0) printf "%.2f", u / s * 100; else print "0" }')
  FREE_GIB=$(awk -v s="$SIZE" -v u="$UTIL" 'BEGIN { printf "%.2f", (s - u) / 1073741824 }')
  echo "SR_${SAFE_NAME}_Used_Percent : $PCT"
  echo "SR_${SAFE_NAME}_Free_GiB : $FREE_GIB"
done</Value>
