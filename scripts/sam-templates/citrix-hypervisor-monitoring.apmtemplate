					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>ScriptBody</s:Key>
						<s:Value>
							<Required>true</Required>
							<SettingLevel>Template</SettingLevel>
							<Value>#!/bin/sh
set -e

Hostname=$1

enabled=`xe host-list hostname=$Hostname params=enabled --minimal`
live=`xe host-list hostname=$Hostname params=live --minimal`

if [ "$enabled" = "true" ] &amp;&amp; [ "$live" = "true" ]; then
state=1
else
state=0
fi

echo "Statistic.Host_EnabledAndLive : $state";
exit 0</Value>
