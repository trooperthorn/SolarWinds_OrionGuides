							<Value>/tmp</Value>
							<ValueType>String</ValueType>
							<Key>ScriptDirectory</Key>
						</s:Value>
					</s:KeyValueOfstringSettingValueyR_SGpLPx>
					<s:KeyValueOfstringSettingValueyR_SGpLPx>
						<s:Key>StatusRollupType</s:Key>
