				<Name>PerformanceCounter</Name>
				<TemplateID>265</TemplateID>
			</TagInfo>
			<TagInfo>
				<Name>Thermal</Name>
				<TemplateID>265</TemplateID>
			</TagInfo>
		</Tags>
