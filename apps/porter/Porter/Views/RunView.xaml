<UserControl x:Class="Porter.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold"/>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ChipsText" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="Gray" FontSize="12.5"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="OpenLogBtn" Content="Open session log" Click="OpenLog_Click"/>
                <Button x:Name="OpenOutBtn" Content="Open output folder" Click="OpenOut_Click" IsEnabled="False"/>
                <Button x:Name="DoneBtn" Content="Done" FontWeight="SemiBold" Click="Done_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,10,0,0"
                 Background="#101722" Foreground="#C4D2E2" BorderThickness="0" Padding="10"/>
    </DockPanel>
</UserControl>
