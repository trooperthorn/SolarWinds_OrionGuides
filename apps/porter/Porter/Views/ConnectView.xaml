<UserControl x:Class="Porter.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Docking — connect to a SolarWinds Platform server"/>
            <TextBlock Foreground="Gray" Margin="0,4,0,16"
                       Text="IP address, hostname, or FQDN. Porter speaks SWIS over REST (default port 17774)."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Server"/>
                    <TextBox x:Name="ServerBox" Margin="0,3,0,10"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SWIS port"/>
                    <TextBox x:Name="PortBox" Text="17774" Margin="0,3,0,10"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="WinAuthBox" Content="Connect as my current Windows account (no password)"
                      Margin="0,2,0,10" Checked="WinAuth_Changed" Unchecked="WinAuth_Changed"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Username"/>
                    <TextBox x:Name="UserBox" Margin="0,3,0,10"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Password"/>
                    <PasswordBox x:Name="PassBox" Margin="0,3,0,10"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="VerifyTlsBox" Margin="0,2,0,8">
                <TextBlock TextWrapping="Wrap"
                    Text="Verify TLS certificate — leave off for the stock self-signed 'SolarWinds-Orion' certificate; turn on once a domain-trusted certificate is bound to SWIS (see README)"/>
            </CheckBox>
            <TextBlock Foreground="Gray" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="Porter remembers the last server, port, auth mode, and username — never the password, which is always re-entered. With verification off, every session records the presented certificate's SHA-256 fingerprint in the Captain's Log; with it on, an unknown certificate can be pinned by thumbprint."/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="TestBtn" Content="Pathfinder — test" ToolTip="Test the connection without keeping it"
                        AutomationProperties.Name="Test connection" Click="Test_Click"/>
                <Button x:Name="ConnectBtn" Content="Dock — connect" FontWeight="SemiBold"
                        AutomationProperties.Name="Connect" Click="Connect_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
