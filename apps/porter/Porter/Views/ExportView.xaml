<UserControl x:Class="Porter.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Export — Modern Dashboards"/>
            <DockPanel Margin="0,10,0,8">
                <TextBox x:Name="FilterBox" Width="230" DockPanel.Dock="Left"
                         TextChanged="Filter_Changed" VerticalContentAlignment="Center"
                         ToolTip="Filter by name or key"/>
                <Button Content="Select all" Margin="10,0,0,0" Click="All_Click"/>
                <Button Content="Select none" Click="None_Click"/>
                <CheckBox x:Name="ShowSystemBox" Content="Show built-in / system items"
                          VerticalAlignment="Center" Margin="6,0,0,0"
                          Checked="ShowSystem_Changed" Unchecked="ShowSystem_Changed"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontWeight="SemiBold" Text="0 selected"/>
            </DockPanel>
        </StackPanel>

        <Border DockPanel.Dock="Right" Width="270" Margin="18,0,0,0" Padding="14"
                BorderBrush="#C9D2DD" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Output"/>
                <RadioButton x:Name="FmtRaw" Content="Raw files" IsChecked="True" Margin="0,8,0,4"/>
                <RadioButton x:Name="FmtZip" Content="Package (.zip + manifest)" Margin="0,0,0,4"/>
                <RadioButton x:Name="FmtAes" Content="Encrypted package (.zip.aes)"
                             Checked="Fmt_Changed" Unchecked="Fmt_Changed"/>
                <TextBlock Text="Package password" Margin="0,8,0,2" FontSize="12"/>
                <PasswordBox x:Name="AesPass" IsEnabled="False"/>
                <TextBlock Text="Destination folder" Margin="0,12,0,2" FontSize="12"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="…" Padding="8,2" Click="Browse_Click"/>
                    <TextBox x:Name="DestBox" IsReadOnly="True"/>
                </DockPanel>
                <Button x:Name="ExportBtn" Content="Export 0 selected" FontWeight="SemiBold"
                        Margin="0,16,0,0" Click="Export_Click"/>
                <Button Content="Back" Margin="0,8,0,0" Click="Back_Click"/>
            </StackPanel>
        </Border>

        <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="11.5" Margin="0,6,0,0"
                       Text="Space toggles the selected rows · Shift+Click selects a range · Ctrl+A checks all · Ctrl+Shift+A unchecks all · F5 refreshes"/>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False"
                      HeadersVisibility="Column" PreviewKeyDown="Grid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" CanUserResize="False" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <CheckBox Loaded="HeadCheck_Loaded" Click="HeadCheck_Click"
                                      ToolTip="Select all / none (visible rows)"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          Click="RowCheck_Click" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Unique key" Binding="{Binding UniqueKey}" Width="300"
                                        IsReadOnly="True" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Built-in" Binding="{Binding SystemLabel}" Width="70"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>
