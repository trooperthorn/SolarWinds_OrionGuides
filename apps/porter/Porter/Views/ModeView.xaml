<UserControl x:Class="Porter.Views.ModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="What are we doing today?"/>
            <TextBlock Foreground="Gray" Margin="0,4,0,18" TextWrapping="Wrap"
                       Text="Export reads configuration out of the connected server as files. Import brings exported files in — validated before anything is written. Nothing runs without an explicit click on the final button."/>

            <Button AutomationProperties.Name="Export" Click="Export_Click"
                    HorizontalContentAlignment="Stretch" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Export · Orion Transit"/>
                    <TextBlock Foreground="Gray" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Pull configuration out of this server. Pick any mix of items on the Cargo Manifest — filter as you type; Space, Shift+Click, and Ctrl+A multi-select; built-in items stay hidden until you ask for them. Then write raw .json files, a cargo pod (.zip with a manifest), or a cloaked cargo pod (.zip.aes, AES-256-GCM encrypted). Export only reads — nothing on the server changes."/>
                </StackPanel>
            </Button>

            <Button AutomationProperties.Name="Import" Click="Import_Click"
                    HorizontalContentAlignment="Stretch" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Import · Project Genesis"/>
                    <TextBlock Foreground="Gray" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Bring exported files into this server. Files stage in the Airlock and pass pre-flight validation before any API call is made. Run the Simulation first — a dry run that reports GO or NO-GO for every staged file with zero writes. When an item already exists on the target, your collision policy decides: Prime Directive skips it (each skip reported by name), or Replicate imports a renamed copy with fresh GUIDs. Every real import is verified by re-query before it counts as done."/>
                </StackPanel>
            </Button>

            <Button AutomationProperties.Name="Backup and Restore" IsEnabled="False"
                    HorizontalContentAlignment="Stretch" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Backup &amp; Restore · Cryogenic Stasis"/>
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="In Dry Dock — pinned to v2. Freeze will snapshot every supported area into one package on a schedule; Revive will restore by matching existing objects instead of recreating them, so node polling history survives the round trip. The card stays visible so the roadmap is honest."/>
                </StackPanel>
            </Button>

            <Button Content="Back" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Back_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
