<Window x:Class="Porter.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Package password" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <PasswordBox x:Name="Box"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button Content="OK" IsDefault="True" FontWeight="SemiBold" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
