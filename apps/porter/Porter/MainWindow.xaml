<Window x:Class="Porter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Porter — SolarWinds configuration import/export"
        Width="1060" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E2733" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="Crumb" Foreground="#E8EDF3" FontSize="13" VerticalAlignment="Center"
                           Text="Connect"/>
                <TextBlock x:Name="SessionBadge" DockPanel.Dock="Right" Foreground="#9FB0C2"
                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="not connected"/>
            </DockPanel>
        </Border>
        <ContentControl x:Name="Host" Margin="0"/>
    </DockPanel>
</Window>
