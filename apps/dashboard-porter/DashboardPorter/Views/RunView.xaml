<UserControl x:Class="DashboardPorter.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="12" Margin="0,6,0,0"
                   Text="Every action below is also written plainly to the session log (JSONL)"/>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ChipsText" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="Gray" FontSize="12.5"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="AbortBtn" Content="Abort" ToolTip="Stop after the step in flight"
                        AutomationProperties.Name="Abort run" Click="Abort_Click"/>
                <Button x:Name="OpenLogBtn" Content="Session log" ToolTip="Open the JSONL session log"
                        AutomationProperties.Name="Open session log" Click="OpenLog_Click"/>
                <Button x:Name="OpenOutBtn" Content="Open destination folder" ToolTip="Open the output folder"
                        AutomationProperties.Name="Open output folder" Click="OpenOut_Click" IsEnabled="False"/>
                <Button x:Name="DoneBtn" Content="Done" FontWeight="SemiBold" Click="Done_Click" IsEnabled="False"/>
                <Button x:Name="ImportNowBtn" Content="Import Now" ToolTip="Run the real import using these same staged files"
                        AutomationProperties.Name="Import now" FontWeight="SemiBold" Click="ImportNow_Click"
                        Visibility="Collapsed" IsEnabled="False"/>
                <Button x:Name="BackBtn" Content="Back" ToolTip="Back to the staged file list — nothing more is written"
                        AutomationProperties.Name="Back to the list" Click="Back_Click"
                        Visibility="Collapsed" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,10,0,0"
                 Background="#101722" Foreground="#C4D2E2" BorderThickness="0" Padding="10"/>
    </DockPanel>
</UserControl>
