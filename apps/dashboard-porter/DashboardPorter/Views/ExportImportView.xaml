<UserControl x:Class="DashboardPorter.Views.ExportImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28">
        <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"
                   Text="Modern Dashboards"/>
        <TextBlock DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Export reads dashboards out of the connected server as files. Import brings exported files back in, validated before anything is written. Nothing runs without an explicit click on Export or Import."/>

        <TabControl x:Name="Tabs">
            <!-- ================= Import tab ================= -->
            <TabItem Header="Import">
                <DockPanel Margin="0,14,0,0">
                    <Border DockPanel.Dock="Top" AllowDrop="True" Drop="Drop_Files" DragOver="Drag_Over"
                            BorderBrush="#B9C4D2" BorderThickness="2" CornerRadius="6" Margin="0,0,0,10"
                            Padding="16" Background="#FAFBFC">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="DropText" HorizontalAlignment="Center" Foreground="Gray"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Text="Drop exported dashboard files, a package (.zip), or an encrypted package (.zip.aes) here. Nothing is imported until you say so."/>
                            <Button x:Name="ImportBrowseBtn" Content="Browse files…" FontWeight="SemiBold"
                                    HorizontalAlignment="Center" Padding="16,7" Margin="0,10,0,0"
                                    AutomationProperties.Name="Browse for files to import" Click="ImportBrowse_Click"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Right" Width="300" Margin="18,0,0,0" Padding="14"
                            BorderBrush="#C9D2DD" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="If a dashboard already exists on the target"/>
                            <RadioButton x:Name="PolicySkip" IsChecked="True" Margin="0,8,0,2">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Skip it (every skip is reported by name)"/>
                            </RadioButton>
                            <RadioButton x:Name="PolicyCopy" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Import as a copy (new GUIDs, renamed '… (Copy)')"/>
                            </RadioButton>
                            <TextBlock Foreground="Gray" FontSize="11.5" TextWrapping="Wrap"
                                       Text="Existence is matched by each dashboard's key. Copies get every identity regenerated so the server sees a new object, and the run report shows the new name."/>
                            <Separator Margin="0,10"/>
                            <CheckBox x:Name="AllowWarnBox" IsChecked="True"
                                      Checked="AllowWarn_Changed" Unchecked="AllowWarn_Changed">
                                <TextBlock TextWrapping="Wrap" Text="Import files that carry warnings"/>
                            </CheckBox>
                            <Button x:Name="DryRunBtn" Content="Dry run (no writes)"
                                    AutomationProperties.Name="Dry run" Margin="0,14,0,0" Click="DryRun_Click"/>
                            <Button x:Name="ImportBtn" Content="Import (0)" ToolTip="Import the staged files"
                                    AutomationProperties.Name="Import staged files" FontWeight="SemiBold"
                                    Margin="0,8,0,0" Click="Import_Click"/>
                            <Button Content="Clear staged files" Margin="0,8,0,0" Click="ClearStaged_Click"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <ListView x:Name="StageList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="34"
                                    DisplayMemberBinding="{Binding StatusGlyph}"/>
                                <GridViewColumn Header="File" Width="260"
                                    DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="Pre-flight checks" Width="380"
                                    DisplayMemberBinding="{Binding Summary}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ================= Export tab ================= -->
            <TabItem Header="Export">
                <DockPanel Margin="0,14,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox x:Name="FilterBox" Width="230" DockPanel.Dock="Left"
                                 TextChanged="Filter_Changed" VerticalContentAlignment="Center"
                                 ToolTip="Filter by name or key"/>
                        <Button Content="Select all" Margin="10,0,0,0" Click="All_Click"/>
                        <Button Content="Select none" Click="None_Click"/>
                        <CheckBox x:Name="ShowSystemBox" Content="Show built-in / system dashboards"
                                  VerticalAlignment="Center" Margin="6,0,0,0"
                                  Checked="ShowSystem_Changed" Unchecked="ShowSystem_Changed"/>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Text="0 selected"/>
                    </DockPanel>

                    <Border DockPanel.Dock="Right" Width="290" Margin="18,0,0,0" Padding="14"
                            BorderBrush="#C9D2DD" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Output"/>
                            <RadioButton x:Name="FmtRaw" IsChecked="True" Margin="0,8,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Raw files"/>
                            </RadioButton>
                            <RadioButton x:Name="FmtZip" Margin="0,0,0,4">
                                <TextBlock TextWrapping="Wrap" Text="Package (.zip + manifest)"/>
                            </RadioButton>
                            <RadioButton x:Name="FmtAes" Checked="Fmt_Changed" Unchecked="Fmt_Changed">
                                <TextBlock TextWrapping="Wrap" Text="Encrypted package (.zip.aes)"/>
                            </RadioButton>
                            <TextBlock Text="Package password" Margin="0,8,0,2" FontSize="12"/>
                            <PasswordBox x:Name="AesPass" IsEnabled="False"/>
                            <TextBlock Text="Destination folder" Margin="0,12,0,2" FontSize="12"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" Padding="8,2" Click="Browse_Click"/>
                                <TextBox x:Name="DestBox" IsReadOnly="True"/>
                            </DockPanel>
                            <Button x:Name="ExportBtn" Content="Export (0)" ToolTip="Export the selected dashboards"
                                    AutomationProperties.Name="Export selected" FontWeight="SemiBold"
                                    Margin="0,16,0,0" Click="Export_Click"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="11.5" Margin="0,6,0,0"
                                   Text="Space toggles the selected rows · Shift+Click selects a range · Ctrl+A checks all · Ctrl+Shift+A unchecks all · F5 refreshes"/>
                        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False"
                                  HeadersVisibility="Column" PreviewKeyDown="Grid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" CanUserResize="False" IsReadOnly="True">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox Loaded="HeadCheck_Loaded" Click="HeadCheck_Click"
                                                  ToolTip="Select all / none (visible rows)"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="RowCheck_Click" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Key" Binding="{Binding UniqueKey}" Width="280"
                                                    IsReadOnly="True" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Built-in" Binding="{Binding SystemLabel}" Width="70"
                                                    IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
